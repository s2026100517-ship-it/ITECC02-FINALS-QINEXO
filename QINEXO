//Booking date and time
void bookingDateTime(string &lastBookingDate, string &lastBookingTime) {
    time_t bookingNow = time(0) + (8 * 60 * 60);
    tm *bookingLocal = gmtime(&bookingNow);
    lastBookingDate = to_string(bookingLocal->tm_mon + 1) + "/" +
                      to_string(bookingLocal->tm_mday) + "/" +
                      to_string(bookingLocal->tm_year + 1900);
    int hour = bookingLocal->tm_hour;
    string period = (hour >= 12) ? "PM" : "AM";

    if (hour > 12) {
        hour -= 12;
    }
    else if (hour == 0) {
        hour = 12;
    }

    lastBookingTime = to_string(hour) + ":" +
                      (bookingLocal->tm_min < 10 ? "0" : "") +
                      to_string(bookingLocal->tm_min) + " " + period;
}

