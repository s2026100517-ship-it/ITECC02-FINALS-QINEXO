                                }
                            }
                        
                        } while (ticket <= 0);

                        availableSeats = 0;
                        for (int i = 0; i < 20; i++) {
                            if (booked[movie - 1][sched - 1][i] == false) {
                                availableSeats++;
                            }
                        }

                        if (ticket > availableSeats) {
                            if (availableSeats == 0) {
                                cout << "\n\t      Sorry, there are no more" << endl;
                                cout << "\t  available seats for this screening." << endl;
                            }
                            else {
                                cout << "\n          Sorry, only " << availableSeats << " seats are available." << endl;
                            }
                            returnEnd(confirm4, confirmed4, "schedule selection");

                            if (!confirmed4) {
                                returnToMenu = true;
                            }
                            else {
                                returnToSchedule = true;
                            }
                            break;
                        }
                        
                        confirmation(confirm5, ticketConfirmed, "Returning to ticket quantity");

                        if (!ticketConfirmed) {
                            continue;
                        }

                        //Available seats
                        string confirm6;
                        bool confirmed6 = false;
                        
                        while (!confirmed6) {
                        
                            cout << "\n";
                            cout << "\t\t    Available seats" << endl;
                            cout << "\n";
                            cout << "\t\t        Screen" << endl;
                            cout << "\n";
                        
                            count = 0;
                        
                            //Seat selection
                            while (count < ticket) {
                        
                                for (int i = 0; i < 20; i++) {
                                    if (i % 5 == 0) {
                                        cout << "\t       ";
                                    }
                                
                                    if (booked[movie - 1][sched - 1][i] == false) {
                                        cout << "[" << seats[i] << "] ";
                                    }
                                    else {
                                        cout << "[XX] ";
                                    }
                                
                                    if ((i + 1) % 5 == 0) {
                                        cout << endl;
                                    }
                                }
                        
                                cout << "\n\t       Please choose seat " << count + 1 << ": ";
                                cin >> seatChoice;
                        
                                seatFound = false;
                        
                                for (int i = 0; i < 20; i++) {
                                    bool alreadySelected = false;
                        
                                    for (int j = 0; j < count; j++) {
                                        if (selectedSeats[j] == seatChoice) {
                                            alreadySelected = true;
                                        }
                                    }
                        
                                    if (seatChoice == seats[i] &&
                                        booked[movie - 1][sched - 1][i] == false &&
                                        !alreadySelected) {
                        
                                        selectedSeats[count] = seatChoice;
                                        seatFound = true;
                                        count++;
                        
                                        cout << "\n\t    Seat " << seatChoice
                                             << " successfully selected!" << endl;
                                        break;
                                    }
                                }
                        
                                if (!seatFound) {
                                    cout << "\n";
                                    cout << "=====================================================" << endl;
                                    cout << " Invalid or unavailable seat. Please choose another." << endl;
                                    cout << "=====================================================" << endl;
                                    cout << "\n";
                                }
                        
                                cout << "\n";
                            }//End of the selection loop
                        
                            //Display the selected seats
                            cout << "\t         Your selected seats: " << endl;

                            for (int i = 0; i < ticket; i++) {
                                if (i % 5 == 0) {
                                    cout << "\t       ";
                                }
                            
                                cout << "[" << selectedSeats[i] << "] ";
                            
                                if ((i + 1) % 5 == 0 || i == ticket - 1) {
                                    cout << endl;
                                }
                            }
                            cout << "\n\n";
                        
                            confirmation(confirm6, confirmed6, "Returning to seat selection");
                    
                        }//End of the confirmation loop
                        
                        
                        //Seats are marked booked after user confirmation
                        for (int i = 0; i < ticket; i++) {
                            for (int j = 0; j < 20; j++) {
                                if (selectedSeats[i] == seats[j]) {
                                    booked[movie - 1][sched - 1][j] = true;
                                }
                            }
                        }
                        
                        ticketConfirmed = true;
                        reservationFinished = true;

                //Available snacks
                int choice = -1;
                int quantity = 0;
                double snackTotal = 0.0;
                string snackList = "";

                while (choice != 0) {
                    
                    displaySnacks();

                    string choiceInput;
                    bool validChoice = false;
                    
                     while (!validChoice) {
                        cout << "\t       Please select a snack: ";
                        cin >> choiceInput;
                    
                        if (invalidNumber(choiceInput)) {
                            continue;
                        }
                    
                        choice = stoi(choiceInput);
                        validChoice = true;
                    }

                    if (choice == 0) {
                        break;
                    }

                    double snackPrice = 0.0;
                    string snackName;

                    switch (choice) {
                        case 1: snackName = "Popcorn"; snackPrice = 120.00; break;
                        case 2: snackName = "Nachos"; snackPrice = 100.00; break;
                        case 3: snackName = "Hotdog"; snackPrice = 80.00; break;
                        case 4: snackName = "Soda"; snackPrice = 60.00; break;
                        default:
                            invalidSelection("snack");
                            continue;
                    }

                    do {
                        cout << "\t    Enter quantity for " << snackName << ": ";
                        cin >> input;
                    
                        if (invalidNumber(input)) {
                            quantity = 0;
                        }
                        else {
                            quantity = stoi(input);
                    
                            if (quantity <= 0) {
                                invalidInput("       Quantity must be greater than 0.");
                            }
                        }
                    
                    } while (quantity <= 0);

                    double itemTotal = snackPrice * quantity;
                    snackTotal += itemTotal;

                    ostringstream snackLine;
                    snackLine << snackName << " x" << quantity
                              << " - PHP " << fixed << setprecision(2)
                              << itemTotal << "\n";
                    snackList += snackLine.str();

                    cout << "\n\t    " << snackName << " added to your order!" << endl;
                    cout << "\n\n";
                }

                //Payment calculation
                double ticketTotal = ticket * ticketPrice;
                double discountAmount = seniorDiscount(ticketTotal, age);
                double finalTotal = ticketTotal - discountAmount + snackTotal;

                //Store last completed booking for My Bookings
                bookingDateTime(lastBookingDate, lastBookingTime);
                lastName = name;
                lastAge = age;
                lastContact = contact;
                lastMovie = selectedMovie;
                lastRating = selectedRating;
                lastSchedule = selectedSchedule;
                lastTicket = ticket;
                lastSnackList = snackList;
                lastTicketTotal = ticketTotal;
                lastDiscountAmount = discountAmount;
                lastSnackTotal = snackTotal;
                lastFinalTotal = finalTotal;

                for (int i = 0; i < ticket; i++) {
                    lastSeats[i] = selectedSeats[i];
                }

                hasBooking = true;

                //Reeceipt and Booking summary
                cout << "\n\n\n";
                cout << "-----------------------------------------------------" << endl;
                cout << "\n\n\n";
                bookingSummary(lastName, lastAge, lastContact,
                               lastMovie, lastRating, lastSchedule,
                               lastTicket, lastSeats, lastSnackList,
                               lastTicketTotal, lastDiscountAmount,
                               lastSnackTotal, lastFinalTotal,
                               lastBookingDate, lastBookingTime);

                cout << "\n\t Your transaction has been completed." << endl;
                cout << "\n\t     Returning to the main menu..." << endl;
                cout << "\n\n\n";
            }//while (!ticketConfirmed && !returnToSchedule)
                }//while (!reservationFinished && !returnToMenu)
                break;
            }//case 1 end
            
            // SHOWTIMES
            case 2: {
                showtimes();
                break;
            }

            // MY BOOKINGS
            case 3: {
                string searchName;
                string searchContact;
                cout << "\n\n";
                cout << "-----------------------------------------------------" << endl;
                cout << "\n";
                cout << "\t __________________________________" << endl;
                cout << "\t |                                |" << endl;
                cout << "\t |           MY BOOKINGS          |" << endl;
                cout << "\t |________________________________|" << endl;
                cout << "\n\n\n";
                
                cout << "\nEnter your name: ";
                getline(cin >> ws, searchName);
            
                cout << "Enter your contact number: ";
                cin >> searchContact;
            
                if (hasBooking && searchName == lastName &&
                searchContact == lastContact) {
        
                cout << "\n\t\t YOUR BOOKING RECORD" << endl;
        
                bookingSummary(
                    lastName,
                    lastAge,
                    lastContact,
                    lastMovie,
                    lastRating,
                    lastSchedule,
                    lastTicket,
                    lastSeats,
                    lastSnackList,
                    lastTicketTotal,
                    lastDiscountAmount,
                    lastSnackTotal,
                    lastFinalTotal,
                    lastBookingDate,
                    lastBookingTime
                );
        
            } else {
                cout << "\nNo booking records found for the provided details." << endl;
            }
        
            cout << "\n\t     Returning to the main menu..." << endl;
            cout << "\n\n\n";
            break;
            }

            cout << "\n";
            
            // EXIT
            case 4:
                running = false;
                cout << "\n\t    Thank you for choosing QINEXO!" << endl;
                break;

            default:
                invalidSelection("menu");
                break;
        }

        cout << "\n";
    }

    return 0;
