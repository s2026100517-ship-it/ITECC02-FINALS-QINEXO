//Invalid number input
bool invalidNumber(string input) {
    int i = 0;

    while (i < input.length()) {
        if (input[i] < '0' || input[i] > '9') {
            cout << "\n";
            cout << "=====================================================" << endl;
            cout << "     Invalid input! Please enter numbers only." << endl;
            cout << "=====================================================" << endl;
            cout << "\n";

            return true;
        }

        i++;
    }

    return false;
}

